# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Not needed for sign-up; used by local seeding and (later) cron/webhooks.
SUPABASE_SECRET_KEY=
# Optional: public origin used in email-confirmation links (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=
# Local tooling only (scripts/tests).
DATABASE_URL=

